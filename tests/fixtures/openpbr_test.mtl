# Test fixture material library for MaterialLibrary unit tests.
# Covers the full range of OpenPBR parameter types used in Hyperion.
#
# Standard MTL keywords are SILENTLY IGNORED — only OpenPBR keywords used.

colorspace lin_rec709

# Minimal diffuse (only required keyword — everything else is default)
newmtl DiffuseGray
base_color          0.500 0.500 0.500
specular_roughness  0.80

# Conductor: copper F0/F82 values from OpenPBR spec
newmtl Copper
base_color          0.811 0.643 0.542
base_metalness      1.0
specular_color      0.970 0.950 0.946
specular_roughness  0.02

# Dielectric: borosilicate glass
newmtl Glass
base_color          1.000 1.000 1.000
transmission_weight 1.0
specular_ior        1.52
specular_roughness  0.00

# Clearcoat: car paint
newmtl Carpaint
base_color          0.100 0.600 0.900
specular_ior        1.60
coat_weight         1.0
coat_roughness      0.02
coat_ior            1.60

# Fuzz: velvet
newmtl Velvet
base_color          0.062 0.010 0.269
base_diffuse_roughness 1.0
specular_roughness  1.0
fuzz_weight         0.5
fuzz_color          0.315 0.237 0.465
fuzz_roughness      0.5

# Subsurface: skin I
newmtl SkinI
subsurface_weight   1.0
subsurface_color    0.762 0.652 0.568
subsurface_radius   0.482 0.169 0.109
specular_roughness  0.50
specular_ior        1.40

# Emissive: warm light
newmtl Emissive
base_color          1.000 0.875 0.625
emission_color      1.000 0.875 0.625
emission_luminance  100000.0
